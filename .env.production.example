# Values read by the browser, fixed when the application is built.

# Leave empty unless the application is served under a sub-path.
NEXT_PUBLIC_BASE_PATH=
# Behind a reverse proxy serving the application and the API on the same
# address, keep these relative. Otherwise give the full address of the API.
NEXT_PUBLIC_GRAPHQL_URL=/graphql
NEXT_PUBLIC_BACKEND_URL=/
# true shows the read-only demonstration banner.
NEXT_PUBLIC_DEMO_MODE=false

# Public integrations
NEXT_PUBLIC_OPENWEATHERMAP_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_OPENAIP_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Read by the server when it starts, not by the browser: address of the API
# inside the private network, required when NEXT_PUBLIC_GRAPHQL_URL is relative.
INTERNAL_GRAPHQL_URL=http://backend:3000/graphql
